  "phase_requirements": {
    "preflight": {
      "required": ["phase-preflight", "integrations"],
      "conditional": ["shell-safety"],
      "validation": ".spotlight-config.json stores full integration status, not only booleans."
    },
    "methodology": {
      "required": ["phase-methodology", "integrations", "osint", "investigation-methodology", "epistemic-grounding"],
      "conditional": ["navigator", "arbiter", "follow-the-money", "social-media-intelligence", "technical-investigation", "content-access"],
      "validation": "methodology.json includes skills_invoked[] and required Navigator fields when green."
    },
    "investigation": {
      "required": ["phase-investigation", "epistemic-grounding", "shell-safety", "web-archiving"],
      "conditional": ["content-access", "acquisition-graduation", "arbiter", "social-media-intelligence", "technical-investigation"],
      "validation": "findings contain evidence refs, archives, and confidence caps."
    },
    "investigation-fact-check": {
      "required": ["phase-investigation", "epistemic-grounding", "content-access", "shell-safety"],
      "conditional": ["navigator", "arbiter", "osint", "social-media-intelligence", "technical-investigation", "web-archiving"],
      "validation": "fact-check output independently checks investigator claims."
    },
    "report": {
      "required": ["phase-report", "report-drafting", "epistemic-grounding"],
      "conditional": ["arbiter", "provenance-signing", "technical-investigation"],
      "validation": "report claims map to evidence ledger."
    },
    "ingest": {
      "required": ["phase-ingest", "ingest"],
      "conditional": [],
      "validation": "only verified or explicitly caveated material enters vault."
    }
  }
