{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_version": "1.0",
  "type": "object",
  "required": ["schema_version", "project", "investigation_plan"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": { "type": "string" },
    "lead": { "type": "string" },
    "planned_at": { "type": "string", "format": "date-time" },
    "brief_directions": { "type": "array", "items": { "type": "string" } },
    "skills_invoked": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Skills explicitly loaded while designing the methodology."
    },
    "method_provenance": {
      "type": "array",
      "description": "Reviewed third-party method adaptations selected for this case; not factual source citations.",
      "items": {
        "type": "object",
        "required": ["skill_id", "method", "upstream", "active_sha", "reference"],
        "properties": {
          "skill_id": { "const": "technical-investigation" },
          "method": {
            "enum": ["indicator-triage", "infrastructure-history", "document-message-forensics", "github-public", "verified-indicator-export"]
          },
          "upstream": { "const": "7onez/cti-expert" },
          "active_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "reference": {
            "enum": [
              "indicator-triage-compact.md",
              "indicator-triage.md",
              "infrastructure-history-compact.md",
              "infrastructure-history.md",
              "document-message-forensics-compact.md",
              "document-message-forensics.md",
              "github-public-compact.md",
              "github-public.md",
              "verified-indicator-export.md"
            ]
          }
        }
      }
    },
    "navigator": {
      "type": "object",
      "required": ["required", "used"],
      "properties": {
        "required": { "type": "boolean" },
        "used": { "type": "boolean" },
        "status": { "enum": ["green", "yellow", "red", "missing", "unknown"] },
		"interface": { "enum": ["cli", "api_fallback", "none"] },
		"capabilities": { "type": "array", "items": { "enum": ["osint_tools"] } },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
			"required": ["direction", "response_path"],
            "properties": {
              "direction": { "type": "string" },
			  "mode": { "enum": ["tool_discovery"] },
			  "interface": { "enum": ["cli", "api_fallback"] },
			  "command": { "type": "string" },
			  "catalog_id": { "type": "string" },
			  "catalog_version": { "type": "string" },
			  "retrieved_at": { "type": "string", "format": "date-time" },
			  "endpoint": { "enum": ["/api/tools/search", "/api/query"] },
              "request_path": { "type": "string" },
              "response_path": { "type": "string" },
              "selected_tools": { "type": "array", "items": { "type": "string" } },
              "rejected_tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tool": { "type": "string" },
                    "reason": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "fallback_used": { "type": "boolean" },
        "fallback_reason": { "type": "string" }
      }
    },
    "indicator_framework": {
      "type": "object",
      "description": "Whether the investigator and fact-checker use the Indicator Framework (a Navigator-hosted skill for Lab members) on this case. Proposed on only for a connection or attribution question about digital assets when the member has Lab access; the member's methodology approval confirms it.",
      "required": ["on", "reason"],
      "additionalProperties": false,
      "properties": {
        "on": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "anomaly": {
      "type": "object",
      "description": "Present only when the member opted in to Anomaly in the brief conversation: the Anomaly domains (types of data) and data sources judged useful for this case, from the anomaly_methods lookup, and why. A rough plan: which detector runs on which table is decided in Investigation, once the tables are in hand. The member's methodology approval confirms it.",
      "required": ["domains"],
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["domain", "sources", "why"],
            "additionalProperties": false,
            "properties": {
              "domain": { "type": "string", "minLength": 1, "description": "An Anomaly domain, or any_table for the core detectors that run on any table." },
              "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "Anomaly source ids to fetch tables from; empty when the tables come from elsewhere." },
              "why": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rlm": {
      "type": "object",
      "description": "Per-case RLM decision made during methodology approval. RLM output is lead-only and never publishable evidence.",
      "required": ["available", "proposed", "approved", "mode", "evidence_boundary"],
      "properties": {
        "available": { "type": "boolean" },
        "proposed": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "mode": { "enum": ["off", "lite", "local_gemma4_e4b"] },
        "model": { "type": ["string", "null"] },
        "prefilter": { "type": "boolean" },
        "hybrid": { "type": "boolean" },
        "decision_at": { "type": "string", "format": "date-time" },
        "decision_by": { "type": "string" },
        "run_id": { "type": "string" },
        "request_path": { "type": "string" },
        "analysis_path": { "type": "string" },
        "audit_path": { "type": "string" },
        "declined_reason": { "type": "string" },
        "skip_reason": { "type": "string" },
        "evidence_boundary": {
          "const": "lead-only; never verified or publishable"
        }
      }
    },
    "investigation_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["direction", "questions", "steps"],
        "properties": {
          "direction": { "type": "string" },
          "direction_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable slug the research plan's topics and the research leads refer to."
          },
          "questions": { "type": "array", "items": { "type": "string" } },
          "navigator_not_applicable_reason": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["order", "action", "tool"],
              "properties": {
                "order": { "type": "integer" },
                "action": { "type": "string" },
                "tool": { "type": "string" },
                "target": { "type": "string" },
                "expected_evidence": { "type": "string" },
                "fallback": { "type": "string" },
                "tool_source": {
                  "enum": ["navigator", "curated-catalog", "prior-vault", "user-specified"]
                },
                "navigator_response_path": { "type": "string" },
                "cites": {
                  "type": "array",
                  "description": "A step added by a Research-gate amendment cites the pursued clue or kept or added direction it serves (D8).",
                  "items": { "type": "string", "pattern": "^(clue|direction):[A-Za-z0-9][A-Za-z0-9._:-]*$" }
                }
				,"navigator_catalog_id": { "type": "string" }
				,"navigator_retrieved_at": { "type": "string", "format": "date-time" }
              }
            }
          },
          "osint_techniques": { "type": "array", "items": { "type": "string" } },
          "key_sources": { "type": "array", "items": { "type": "string" } },
          "risks": { "type": "array", "items": { "type": "string" } },
          "estimated_difficulty": { "enum": ["quick scan", "moderate", "deep document trail"] }
        }
      }
    },
    "research_plan": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opt-in Research phase between Methodology and Investigation. Absent: the case goes straight to Investigation. Each topic brief runs as one lane; code starts the lanes once the methodology is approved, never the model.",
      "required": ["round_budget_usd", "case_budget_usd", "mode", "consent", "keys", "egress", "topics"],
      "properties": {
        "round_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5,
          "default": 1,
          "description": "Spend ceiling for one research round. When it is spent no new topic starts; running ones finish."
        },
        "case_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5,
          "description": "Spend ceiling across every research round of the case; never above 5."
        },
        "timing_window_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Clue rule K3: two dated events of the same subject this many days apart or closer are a timing clue. Unset: K3 does not fire."
        },
        "mode": {
          "enum": ["local_only", "openrouter_swarm", "subscription_subagents", "newsroom"],
          "description": "local_only: only the local lanes run. openrouter_swarm: the member's key with the Research switch on. subscription_subagents: the host's own subagents. newsroom: the newsroom's allowed endpoints only."
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["swarm"],
          "description": "What the member consents to. Who consented and when is their Methodology approval (the approval receipt), never a field of the plan.",
          "properties": {
            "swarm": { "type": "boolean", "description": "The member opted in to sending the approved topic briefs to a cloud model." },
            "journalist_input": { "type": "boolean", "description": "The member granted the local corpus lane access to journalist input (local model only)." },
            "decided_by": { "type": "string", "minLength": 1, "description": "Ignored, never shown: older plans carry a model-written stamp here." },
            "decided_at": { "type": "string", "format": "date-time", "description": "Ignored, never shown, as decided_by." }
          }
        },
        "keys": {
          "type": "array",
          "description": "Names of the keys the lanes use, never their values.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "topics"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "topics": { "type": "array", "items": { "$ref": "#/definitions/slug" } }
            }
          }
        },
        "egress": {
          "type": "array",
          "description": "Where each topic's requests go.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic_id", "destination"],
            "properties": {
              "topic_id": { "$ref": "#/definitions/slug" },
              "destination": { "enum": ["openrouter", "subscription_host", "local_model", "public_web", "registry_api", "newsroom"] },
              "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic_id", "direction_id", "lane_type", "questions"],
            "properties": {
              "topic_id": {
                "$ref": "#/definitions/slug",
                "description": "<direction_id>-<lane_type>[-n], e.g. ownership-registries; also the lane folder research/swarm/<topic_id>/."
              },
              "direction_id": { "$ref": "#/definitions/slug" },
              "lane_type": {
                "$ref": "#/definitions/slug",
                "description": "A lane catalogue id, or ad-hoc (generic search and fetch only, no keys)."
              },
              "route": { "enum": ["swarm", "subscription", "local"] },
              "questions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "seed_queries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "sources_to_try": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "anomaly_methods": {
                "type": "array",
                "uniqueItems": true,
                "description": "Retired: Anomaly runs in Investigation (the methodology's anomaly section). A plan approved before the move may carry an empty list; D1 refuses a non-empty one.",
                "items": { "type": "string", "pattern": "^method:[a-z0-9][a-z0-9._-]*@[0-9A-Za-z][0-9A-Za-z.+-]*$" }
              },
              "token_budget": { "type": "integer", "minimum": 1, "description": "Keeps one topic from taking the round." },
              "journalist_input": { "type": "boolean", "description": "Local corpus lane only, on the local model, with no search or fetch." }
            }
          }
        }
      }
    },
    "tools_required": { "type": "array", "items": { "type": "string" } },
    "opsec_considerations": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
