{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_version": "1.0",
  "type": "object",
  "required": ["project", "findings"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1"] },
    "project": { "type": "string" },
    "lead": { "type": "string" },
    "investigated_at": { "type": "string", "format": "date-time" },
    "cycle": { "type": "integer", "minimum": 1 },
    "questions": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "evidence", "sources", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "finding_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of canonical UTF-8 JSON containing exactly the claim field, with sorted keys, compact separators, ensure_ascii=false, and no Unicode normalization."
          },
          "evidence": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "type": { "enum": ["court_filing","news","registry","social_media","government","ngo_report","satellite","search_result","apify_dataset","file","url","corporate","other"] },
                "accessed": { "type": "string" },
                "archive_url": { "type": "string" },
                "local_file": { "type": "string" },
                "access_method": { "enum": ["full_text","open_access","archive_copy","abstract_only","inaccessible"] },
                "id": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "confidence": { "enum": ["high","medium","low","disputed"] },
          "confidence_rationale": { "type": "string" },
          "grounding": { "$ref": "#/definitions/grounding" },
          "evidence_bundle_refs": { "type": "array", "items": { "type": "string" } },
          "perspective": { "type": "string" }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relationship"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "relationship": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "next_steps": { "type": "array", "items": { "type": "string" } },
    "technical_indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "finding_id", "type", "value", "context", "sources"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "finding_id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["ipv4", "ipv6", "domain", "url", "md5", "sha1", "sha256", "bitcoin", "ethereum"] },
          "value": { "type": "string", "minLength": 1 },
          "context": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "first_observed": { "type": "string", "format": "date-time" },
          "last_observed": { "type": "string", "format": "date-time" }
        }
      }
    },
    "monitoring_recommendations": {
      "type": "array",
      "items": { "$ref": "#/definitions/monitoring_recommendation" }
    }
  },
  "oneOf": [
    {
      "description": "Legacy contract. Omitted schema_version remains valid for backward compatibility.",
      "properties": { "schema_version": { "const": "1.0" } }
    },
    {
      "description": "Source-expression-aware findings contract.",
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "const": "1.1" },
        "findings": {
          "items": { "required": ["finding_fingerprint"] }
        }
      }
    }
  ],
  "definitions": {
    "grounding": {
      "type": "object",
      "required": [
        "support_type",
        "source_role",
        "claim_elements_supported",
        "missing_assumptions",
        "confidence_cap",
        "misgrounding_risk",
        "grounding_rationale"
      ],
      "properties": {
        "support_type": { "enum": ["direct","indirect","inferred","contradicted","insufficient"] },
        "source_role": { "enum": ["primary","secondary","contextual"] },
        "claim_elements_supported": { "type": "array", "items": { "type": "string" } },
        "missing_assumptions": { "type": "array", "items": { "type": "string" } },
        "confidence_cap": { "enum": ["high","medium","low"] },
        "misgrounding_risk": { "type": "string" },
        "grounding_rationale": { "type": "string" }
      }
    },
    "monitoring_recommendation": {
      "type": "object",
      "required": ["id", "target", "scout_type", "criteria", "rationale", "priority"],
      "properties": {
        "id": { "type": "string" },
        "target": { "type": "string" },
        "scout_type": { "enum": ["web","pulse","social","civic"] },
        "criteria": { "type": "string" },
        "rationale": { "type": "string" },
        "priority": { "enum": ["high","medium","low"] },
        "finding_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
