{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotlight.buriedsignals.com/schemas/editorial-mcp/get_record.schema.json",
  "title": "Editorial MCP tool get_record",
  "description": "One approved record.",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:/-]+$"
        }
      },
      "required": [
        "record_id"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "record": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._:/-]+$"
            }
          },
          "required": [
            "record_id"
          ]
        }
      },
      "required": [
        "record"
      ]
    }
  }
}
