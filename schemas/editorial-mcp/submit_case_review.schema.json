{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotlight.buriedsignals.com/schemas/editorial-mcp/submit_case_review.schema.json",
  "title": "Editorial MCP tool submit_case_review",
  "description": "Submit. Integrity checks block; otherwise stages an immutable revision and returns the review to open.",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,200}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "package": {
          "$ref": "package.schema.json"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "media_type": {
                "type": "string"
              },
              "content_base64": {
                "type": "string",
                "contentEncoding": "base64"
              }
            },
            "required": [
              "path",
              "sha256",
              "media_type",
              "content_base64"
            ]
          }
        }
      },
      "required": [
        "case_ref",
        "idempotency_key",
        "package",
        "files"
      ]
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": {
              "const": "staged"
            },
            "submission_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,200}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "review_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,200}$"
            },
            "review_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "status",
            "submission_id",
            "review_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": {
              "const": "rejected"
            },
            "integrity_failures": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "check": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "check",
                  "reason"
                ]
              }
            }
          },
          "required": [
            "status",
            "integrity_failures"
          ]
        }
      ]
    }
  }
}
