{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotlight.buriedsignals.com/schemas/editorial-mcp/package.schema.json",
  "title": "Spotlight case package (submit_case_review)",
  "description": "Built by scripts/newsroom-package.py. Only cited evidence files travel; raw research stays on the journalist's machine.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_version": {
      "const": "spotlight-case-package/1.0"
    },
    "case_id": {
      "type": "string"
    },
    "findings": {
      "type": "object",
      "description": "data/findings.json (schemas/findings.schema.json)"
    },
    "fact_check": {
      "type": "object",
      "description": "data/fact-check.json (schemas/fact-check.schema.json)"
    },
    "passages": {
      "type": "object",
      "description": "data/source-expressions.json (schemas/source-expressions.schema.json)"
    },
    "source_positions": {
      "type": [
        "object",
        "null"
      ],
      "description": "data/source-positions.json (schemas/source-positions.schema.json), or null"
    },
    "evidence_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "media_type": {
                "type": "string"
              },
              "kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "anchor",
                    "raw_path",
                    "downloaded_document_path",
                    "screenshot_path",
                    "text_derivative"
                  ]
                }
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "supporting",
                    "contradicting",
                    "contextual"
                  ]
                }
              },
              "finding_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expression_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes",
              "media_type",
              "kinds",
              "roles",
              "finding_ids",
              "expression_ids",
              "evidence_ids"
            ]
          }
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expression_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "expression_id",
              "reason"
            ]
          }
        }
      },
      "required": [
        "files",
        "omissions"
      ]
    },
    "decision_flags": {
      "type": "object",
      "description": "The run_checks records so far, by kind."
    },
    "dispositions": {
      "type": "object",
      "description": "The investigation-gate and report review records (data/<gate>-review.json) when present."
    },
    "journalist_input_units": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Always empty in open-source Spotlight; a newsroom edition contributes the units a journalist marked for review."
    }
  },
  "required": [
    "package_version",
    "case_id",
    "findings",
    "fact_check",
    "passages",
    "source_positions",
    "evidence_manifest",
    "decision_flags",
    "dispositions",
    "journalist_input_units"
  ]
}
