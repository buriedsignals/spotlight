{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spotlight research clues",
  "description": "data/clues.json: what the clue rules (K1-K6), the triage questions (C1-C4) and any approved method found across the merged leads. The Research page shows clues first; the Research gate receipt binds this file's hash.",
  "schema_version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "leads_sha256", "clues"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "leads_sha256": {
      "$ref": "#/definitions/sha256",
      "description": "sha256 of the data/leads.json these clues were derived from."
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["flag_only", "rules_only", "full"],
          "description": "flag_only: no model answer sets a lead aside."
        },
        "backend": { "type": "string", "minLength": 1 },
        "bank_version": { "type": "string", "minLength": 1 }
      }
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clue_id", "type", "source", "lead_ids", "summary"],
        "allOf": [
          {
            "if": { "required": ["source"], "properties": { "source": { "const": "K2" } } },
            "then": {
              "$comment": "A K2 conflict pair: two leads and the attribute they disagree on.",
              "required": ["attribute"],
              "properties": { "lead_ids": { "minItems": 2, "maxItems": 2 } }
            }
          }
        ],
        "properties": {
          "clue_id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["watchlist", "premise_complicated", "premise_contradicted", "conflict", "new_actor", "change", "absence", "timing", "shared_identifier"]
          },
          "source": {
            "type": "string",
            "pattern": "^(K[1-6]|C[1-4]|method:[a-z0-9][a-z0-9._-]*@[0-9A-Za-z][0-9A-Za-z.+-]*)$",
            "description": "The rule, question or method that raised the clue."
          },
          "lead_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "direction_ids": {
            "type": "array",
            "items": { "$ref": "#/definitions/slug" }
          },
          "summary": { "type": "string", "minLength": 1 },
          "attribute": {
            "type": "string",
            "minLength": 1,
            "description": "K2 only: the attribute the two leads give different values for; triage asks C4 about it."
          },
          "always_shown": {
            "type": "boolean",
            "description": "K6 and C1 complicates/contradicts clues are always shown and never set aside (D7)."
          },
          "warning": {
            "type": "string",
            "description": "Shown with the clue, e.g. that absence is not clearance."
          },
          "model_unsure": {
            "type": "boolean",
            "description": "The two option orders disagreed; the answer had no effect."
          }
        }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
