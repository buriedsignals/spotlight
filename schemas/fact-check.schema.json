{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_version": "1.0",
  "type": "object",
  "required": ["project"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": { "type": "string" },
    "source_document": { "type": "string" },
    "checked_at": { "type": "string" },
    "cycle": { "type": "integer", "minimum": 1 },
    "summary": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "total_claims": { "type": "integer" },
            "verified": { "type": "integer" },
            "partially_verified": { "type": "integer" },
            "unverified": { "type": "integer" },
            "disputed": { "type": "integer" },
            "false": { "type": "integer" },
            "mischaracterized": { "type": "integer" }
          }
        },
        { "type": "string" }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_text", "verdict"],
        "not": {
          "anyOf": [
            { "required": ["claim"] },
            { "required": ["status"] }
          ]
        },
        "properties": {
          "id": { "type": ["integer", "string"] },
          "finding_id": { "type": "string" },
          "technical_indicator_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true,
            "description": "Explicit technical indicators assessed by this claim. Values must appear in claim_text and resolve to the same finding_id."
          },
          "claim_text": { "type": "string" },
          "verdict": { "enum": ["verified","partially_verified","unverified","disputed","false","mischaracterized"] },
          "confidence": { "enum": ["high","medium","low"] },
          "grounding_assessment": { "$ref": "#/definitions/grounding_assessment" },
          "evidence_for": { "type": "array", "items": { "$ref": "#/definitions/evidence_item" } },
          "evidence_against": { "type": "array", "items": { "$ref": "#/definitions/evidence_item" } },
          "sources": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "verdict": { "const": "verified" } }
            },
            "then": {
              "required": ["finding_id", "evidence_for"],
              "properties": {
                "evidence_for": {
                  "minItems": 1,
                  "contains": { "$ref": "#/definitions/verified_anchor" }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "verdict": { "const": "partially_verified" } }
            },
            "then": {
              "required": ["finding_id", "evidence_for"],
              "properties": {
                "evidence_for": {
                  "minItems": 1,
                  "contains": { "$ref": "#/definitions/partial_anchor" }
                }
              }
            }
          }
        ]
      }
    },
    "fact_checks": {
      "type": "array",
      "items": { "$ref": "#/definitions/legacy_fact_check" }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/properties/claims/items" },
          { "$ref": "#/definitions/legacy_fact_check" }
        ]
      }
    },
    "gaps_for_next_cycle": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    { "not": { "required": ["claims", "fact_checks"] } },
    { "not": { "required": ["claims", "verdicts"] } },
    { "not": { "required": ["fact_checks", "verdicts"] } }
  ],
  "definitions": {
    "legacy_fact_check": {
      "type": "object",
      "required": ["claim", "status"],
      "not": {
        "anyOf": [
          { "required": ["claim_text"] },
          { "required": ["verdict"] }
        ]
      },
      "properties": {
        "id": { "type": ["integer", "string"] },
        "finding_id": { "type": "string" },
        "claim": { "type": "string" },
        "status": { "enum": ["verified","partially_verified","unverified","disputed","false","mischaracterized"] },
        "confidence": { "enum": ["high","medium","low"] },
        "evidence_for": { "type": "array", "items": { "$ref": "#/definitions/evidence_item" } },
        "evidence_against": { "type": "array", "items": { "$ref": "#/definitions/evidence_item" } },
        "sources": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "verified" } }
          },
          "then": {
            "required": ["finding_id", "evidence_for"],
            "properties": {
              "evidence_for": {
                "minItems": 1,
                "contains": { "$ref": "#/definitions/verified_anchor" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "partially_verified" } }
          },
          "then": {
            "required": ["finding_id", "evidence_for"],
            "properties": {
              "evidence_for": {
                "minItems": 1,
                "contains": { "$ref": "#/definitions/partial_anchor" }
              }
            }
          }
        }
      ]
    },
    "verified_anchor": {
      "anyOf": [
        { "required": ["evidence_bundle_id"] },
        {
          "required": ["access_method"],
          "properties": {
            "access_method": { "enum": ["full_text", "open_access", "archive_copy"] }
          },
          "anyOf": [
            {
              "required": ["local_file"],
              "properties": { "local_file": { "type": "string", "minLength": 1 } }
            },
            { "required": ["source_ref"] }
          ]
        }
      ]
    },
    "partial_anchor": {
      "anyOf": [
        { "required": ["evidence_bundle_id"] },
        {
          "required": ["access_method"],
          "properties": {
            "access_method": { "enum": ["full_text", "open_access", "archive_copy", "abstract_only"] }
          },
          "anyOf": [
            {
              "required": ["local_file"],
              "properties": { "local_file": { "type": "string", "minLength": 1 } }
            },
            { "required": ["source_ref"] }
          ]
        }
      ]
    },
    "grounding_assessment": {
      "type": "object",
      "required": [
        "support_type",
        "claim_elements_checked",
        "missing_assumptions",
        "confidence_cap",
        "assessment"
      ],
      "properties": {
        "support_type": { "enum": ["direct","indirect","inferred","contradicted","insufficient"] },
        "claim_elements_checked": { "type": "array", "items": { "type": "string" } },
        "missing_assumptions": { "type": "array", "items": { "type": "string" } },
        "confidence_cap": { "enum": ["high","medium","low"] },
        "assessment": { "type": "string" }
      }
    },
    "evidence_item": {
      "type": "object",
      "required": ["description", "source"],
      "properties": {
        "description": { "type": "string" },
        "source": { "type": "string" },
        "source_type": { "enum": ["primary","secondary"] },
        "archive_url": { "type": ["string", "null"] },
        "access_method": { "enum": ["full_text","open_access","archive_copy","abstract_only","inaccessible"] },
        "local_file": { "type": ["string", "null"] },
        "evidence_bundle_id": { "type": "string", "minLength": 1 },
        "source_expression_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Exact immutable source-expression relations used by this evidence item. Activated-case enforcement is performed by the case validator.",
          "items": { "$ref": "#/definitions/source_expression_ref" }
        },
        "source_ref": { "$ref": "#/definitions/source_ref" },
        "quote": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "source_expression_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression_id",
        "expression_fingerprint",
        "finding_fingerprint",
        "link_fingerprint"
      ],
      "properties": {
        "expression_id": { "type": "string", "minLength": 1 },
        "expression_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "finding_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "link_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "json_pointer": { "type": "string", "pattern": "^(?:/.*)?$" }
      },
      "oneOf": [
        { "required": ["line_start", "line_end"], "not": { "required": ["json_pointer"] } },
        {
          "required": ["json_pointer"],
          "not": {
            "anyOf": [
              { "required": ["line_start"] },
              { "required": ["line_end"] }
            ]
          }
        }
      ]
    }
  }
}
