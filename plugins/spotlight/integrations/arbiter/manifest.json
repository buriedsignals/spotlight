{
  "id": "arbiter",
  "name": "Arbiter Social Intelligence",
  "description": "Bring your own Arbiter key to browse archived social-media case studies, analyze themes and actors, ask study-scoped questions, and create reviewed collections through Data Navigator.",
  "category": "social-osint",
  "type": "cli",
  "local_binary": "navigator",
  "version_args": ["query", "--help"],
  "version_output_contains": "--input-file",
  "probes": [
    {
      "args": ["data", "show", "global/arbiter/case-studies"],
      "output_contains": "\"queryable\": true",
      "env": {
        "DATANAV_CATALOGUE": "remote",
        "DATANAV_CACHE_FALLBACK": "off"
      }
    }
  ],
  "requires_key": false,
  "env_vars": [],
  "capabilities": [
    "curated-case-study-browse",
    "case-study-creation",
    "query-to-case-study-matching",
    "entity-stance-analysis",
    "hierarchical-theme-analysis",
    "consolidated-case-study-report",
    "actor-community-mapping",
    "ai-agent-questions",
    "engagement-metrics",
    "archived-social-content"
  ],
  "invocable_by": ["investigator", "fact-checker"],
  "homepage": "https://arbiter.simppl.org/",
  "docs": "docs/arbiter-api.md",
  "rate_limit_note": "Arbiter API usage is billed or credit-metered according to the member's own Arbiter account. Data Navigator does not provide a shared hosted key."
}
