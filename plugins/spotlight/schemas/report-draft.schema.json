{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotlight.buriedsignals.com/schemas/report-draft.schema.json",
  "title": "Spotlight model-authored report plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "deck",
    "framing_finding_ids",
    "finding_order",
    "finding_treatments",
    "caveats",
    "next_steps"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "language": {"type": "string", "minLength": 2, "maxLength": 35},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "deck": {"type": "string", "minLength": 1, "maxLength": 900},
    "framing_finding_ids": {"$ref": "#/$defs/findingIds"},
    "finding_order": {"$ref": "#/$defs/findingIds"},
    "finding_treatments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "headline", "summary", "why_it_matters"],
        "properties": {
          "finding_id": {"$ref": "#/$defs/findingId"},
          "headline": {"type": "string", "minLength": 1, "maxLength": 240},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1400},
          "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 900},
          "quote_selections": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/quoteSelection"}
          }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagram"}
    },
    "caveats": {"$ref": "#/$defs/editorialItems"},
    "next_steps": {"$ref": "#/$defs/editorialItems"}
  },
  "$defs": {
    "findingIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/findingId"}
    },
    "findingId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "quoteSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression_id"],
      "properties": {
        "expression_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    },
    "diagram": {
      "oneOf": [
        {"$ref": "#/$defs/structuralDiagram"},
        {"$ref": "#/$defs/timelineDiagram"},
        {"$ref": "#/$defs/barDiagram"}
      ]
    },
    "structuralDiagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "caption", "finding_ids", "connections"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "type": {"enum": ["flow", "hierarchy", "network", "loop"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 180},
        "caption": {"type": "string", "minLength": 1, "maxLength": 500},
        "finding_ids": {"$ref": "#/$defs/findingIds"},
        "connections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/connectionSelector"}
        },
        "focal_entities": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "timelineDiagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "caption", "finding_ids", "indicator_ids"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "type": {"const": "timeline"},
        "title": {"type": "string", "minLength": 1, "maxLength": 180},
        "caption": {"type": "string", "minLength": 1, "maxLength": 500},
        "finding_ids": {"$ref": "#/$defs/findingIds"},
        "indicator_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
        }
      }
    },
    "barDiagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "caption", "finding_ids", "metric"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "type": {"const": "bar"},
        "title": {"type": "string", "minLength": 1, "maxLength": 180},
        "caption": {"type": "string", "minLength": 1, "maxLength": 500},
        "finding_ids": {"$ref": "#/$defs/findingIds"},
        "metric": {"enum": ["verdict_tally", "confidence_distribution", "source_types"]},
        "scope": {"enum": ["all", "finding_ids"], "default": "all"}
      }
    },
    "connectionSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relationship"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "minLength": 1}
      }
    },
    "editorialItems": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "finding_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 700},
          "finding_ids": {"$ref": "#/$defs/findingIds"}
        }
      }
    }
  }
}
