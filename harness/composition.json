{
  "version": 1,
  "runtime": "pi",
  "description": "Per-agent skill bundles for the Pi+Flue harness (PRD D2). Each sub-agent is composed with only its role-relevant subset of the catalog, and bodies load on invoke (D1). Grounded in agents/*.md invoke-skill() calls + the orchestrator's skill-inventory table (skills/spotlight/SKILL.md §3.5). Consumed by U7 (Flue subagents) and measured by U13. Pi harness (harness/pi): each agent runs as its own pi process that loads exactly these skills by path and declares exactly `tools`; optional `keys` lists the environment variables (secrets) that agent's process receives. An agent whose role file is absent cannot be spawned.",
  "agents": {
    "orchestrator": {
      "role": "skills/spotlight/SKILL.md",
      "skills": [
        "phase-preflight",
        "phase-methodology",
        "phase-investigation",
        "phase-investigation-gate",
        "phase-report",
        "phase-ingest",
        "ingest",
        "monitoring",
        "report-drafting",
        "editorial-review",
        "provenance-signing",
        "technical-investigation",
        "integrations"
      ],
      "tools": [
        "spotlight_resolve",
        "spotlight_transition",
        "spawn_agent",
        "invoke_skill"
      ]
    },
    "investigator": {
      "role": "agents/investigator.md",
      "skills": [
        "osint",
        "investigation-methodology",
        "follow-the-money",
        "integrations",
        "content-access",
        "web-archiving",
        "epistemic-grounding",
        "shell-safety",
        "acquisition-graduation",
        "social-media-intelligence",
        "technical-investigation"
      ],
      "tools": [
        "invoke_skill"
      ]
    },
    "fact-checker": {
      "role": "agents/fact-checker.md",
      "skills": [
        "osint",
        "content-access",
        "web-archiving",
        "epistemic-grounding",
        "shell-safety",
        "acquisition-graduation",
        "social-media-intelligence",
        "technical-investigation"
      ],
      "tools": [
        "invoke_skill"
      ]
    },
    "researcher": {
      "role": "agents/researcher.md",
