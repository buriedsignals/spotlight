{
  "version": 1,
  "runtime": "pi",
  "description": "Per-agent skill bundles for the Pi harness. Each sub-agent is composed with only its role-relevant subset of the catalog, and bodies load on invoke. Grounded in agents/*.md invoke-skill() calls + the orchestrator's skill-inventory table (skills/spotlight/SKILL.md \u00a73.5). Pi harness (harness/pi): each agent runs as its own pi process that loads exactly these skills by path and declares exactly `tools`; optional `keys` lists the environment variables (secrets) that agent's process receives. An agent whose role file is absent cannot be spawned. Tools are typed (no shell): case-confined file tools, egress-guarded web tools and fixed-argument wrappers of the checkout's scripts (data/source-expressions.json and data/source-positions.json are written only through source_expressions, never by a file tool); sensitive mode removes fetch, search, http_get, browse, navigator_tools, run_rlm and integration_status from every agent. Optional `reads` and `writes` narrow an agent's file tools to those case files (such an agent may declare only file tools, invoke_skill and query_vault); optional `denyReads` hides case files from an agent's file tools and exiftool while the rest of the case stays readable (an entry ending in / is a folder, * matches within one path segment; the fact-checker is denied the research phase's material); optional `denyWrites` makes an agent's write_file and edit_file refuse those case files, same syntax (the orchestrator is denied the files the workers write and the harness validates after them, so a change goes through the worker and its checks; the investigator and the fact-checker are denied each other's files, so each writes only its own); optional `phases` and `editions` say when the launcher starts it (the analyst runs at Ingest in the solo edition only; launcher.ts refusalFor); optional `phaseScopes` replace a role's `reads` and `writes` at a phase; optional `newsroomTools` are added in the newsroom edition. The orchestrator holds only dispatch tools and writes only brief-directions.txt: its dispatch tools take no case path, so it may hold them with `writes`, and spotlight_resolve runs the mechanical steps itself. `runner` marks a role code runs itself (the researcher: harness/pi/src/lanes.ts runs one lane per approved research topic, with the tools its lane type in lanes/*.yaml names); it is never a spawn_agent worker, and its `skills` serve subscription hosts.",
  "agents": {
    "orchestrator": {
      "role": "skills/spotlight/SKILL.md",
      "skills": [
        "phase-preflight",
        "phase-methodology",
        "phase-research",
        "phase-investigation",
        "phase-investigation-gate",
        "phase-report",
        "phase-ingest",
        "ingest",
        "monitoring",
        "report-drafting",
        "editorial-review",
        "provenance-signing",
        "technical-investigation",
        "integrations"
      ],
      "tools": [
        "spotlight_resolve",
        "spotlight_transition",
        "spawn_agent",
        "invoke_skill",
        "read_file",
        "write_file",
        "open_review"
      ],
      "denyWrites": [
        "data/methodology.json",
        "data/findings.json",
        "data/fact-check.json",
        "summary.md",
        "data/summary.json",
        "data/report-draft.json",
        "data/evidence-bundle.json",
        "data/investigation-log.json",
        "data/source-expressions.json",
        "data/source-positions.json",
        "data/indicator-framework.json",
        "data/indicator-framework.md",
        "data/harness-checks/",
        "research/navigator/"
      ],
      "keys": [
        "NOOSPHERE_C2PA_URL",
        "NOOSPHERE_C2PA_CREDENTIAL_ID",
        "NOOSPHERE_PROVENANCE_API_KEY",
        "OPENROUTER_API_KEY",
        "SPOTLIGHT_RLM_API_KEY"
      ],
      "writes": [
        "brief-directions.txt"
      ],
      "newsroomTools": [
        "run_checks",
        "newsroom_submit"
      ]
    },
    "investigator": {
      "role": "agents/investigator.md",
      "skills": [
        "osint",
        "investigation-methodology",
        "follow-the-money",
        "integrations",
        "content-access",
        "web-archiving",
        "epistemic-grounding",
        "shell-safety",
        "acquisition-graduation",
        "social-media-intelligence",
        "technical-investigation",
        "navigator"
      ],
      "denyWrites": [
        "data/fact-check.json",
        "data/harness-checks/",
        "research/navigator/"
      ],
      "tools": [
        "invoke_skill",
        "read_file",
        "record_finding",
        "write_file",
        "edit_file",
        "list_files",
        "grep_files",
        "hash_files",
        "fetch",
        "search",
        "http_get",
        "browse",
        "query_vault",
        "osint_tools",
        "navigator_tools",
        "exiftool",
        "source_expressions",
        "anomaly_run"
      ],
      "keys": [
        "FIRECRAWL_API_KEY"
      ],
      "denyReads": [
        "data/harness-checks/fact-checker/",
        "data/harness-checks/analyst/"
      ]
    },
    "fact-checker": {
      "role": "agents/fact-checker.md",
      "skills": [
        "osint",
        "content-access",
        "web-archiving",
        "epistemic-grounding",
        "shell-safety",
        "acquisition-graduation",
        "social-media-intelligence",
        "technical-investigation",
        "navigator"
      ],
      "tools": [
        "invoke_skill",
        "read_file",
        "record_assessment",
        "judge_finding",
        "write_file",
        "list_files",
        "grep_files",
        "hash_files",
        "fetch",
        "search",
        "http_get",
        "browse",
        "query_vault",
        "osint_tools",
        "navigator_tools",
        "exiftool",
        "source_expressions"
      ],
      "denyWrites": [
        "data/findings.json",
        "data/methodology.json",
        "data/investigation-log.json",
        "data/harness-checks/",
        "research/navigator/"
      ],
      "denyReads": [
        "research/swarm/",
        "data/leads.json",
        "data/leads.jsonl",
        "data/clues.json",
        "data/research-*.json",
        "data/investigation-log.json",
        "data/harness-checks/investigator/",
        "data/harness-checks/analyst/"
      ],
      "keys": [
        "FIRECRAWL_API_KEY"
      ],
      "phases": [
        "investigation"
      ]
    },
    "researcher": {
      "role": "agents/researcher.md",
      "skills": [
        "osint",
        "content-access",
        "web-archiving",
        "epistemic-grounding"
      ],
      "tools": [
        "invoke_skill"
      ],
      "runner": "research-lanes",
