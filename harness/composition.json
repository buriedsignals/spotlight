{
  "version": 1,
  "runtime": "pi",
  "description": "Per-agent skill bundles for the Pi harness. Each sub-agent is composed with only its role-relevant subset of the catalog, and bodies load on invoke. Grounded in agents/*.md invoke-skill() calls + the orchestrator's skill-inventory table (skills/spotlight/SKILL.md §3.5). Pi harness (harness/pi): each agent runs as its own pi process that loads exactly these skills by path and declares exactly `tools`; optional `keys` lists the environment variables (secrets) that agent's process receives. An agent whose role file is absent cannot be spawned. Tools are typed (no shell): case-confined file tools, egress-guarded web tools and fixed-argument wrappers of the checkout's scripts; sensitive mode removes fetch, search, http_get, browse, navigator_tools, run_rlm and integration_status from every agent. Optional `reads` and `writes` narrow an agent's file tools to those case files (such an agent may declare only file tools, invoke_skill and query_vault); optional `phases` and `editions` say when the launcher starts it.",
  "agents": {
    "orchestrator": {
      "role": "skills/spotlight/SKILL.md",
      "skills": [
        "phase-preflight",
        "phase-methodology",
        "phase-research",
        "phase-investigation",
        "phase-investigation-gate",
        "phase-report",
        "phase-ingest",
        "ingest",
        "monitoring",
        "report-drafting",
        "editorial-review",
        "provenance-signing",
        "technical-investigation",
        "integrations"
      ],
      "tools": [
        "spotlight_resolve",
        "spotlight_transition",
        "spawn_agent",
        "invoke_skill",
        "read_file",
        "write_file",
        "list_files",
        "grep_files",
        "decision_signals",
        "provenance_manifest",
        "build_review_html",
        "run_rlm",
        "integration_status",
        "osint_tools",
        "open_review"
      ],
      "keys": [
        "NOOSPHERE_C2PA_URL",
        "NOOSPHERE_C2PA_CREDENTIAL_ID",
        "NOOSPHERE_PROVENANCE_API_KEY",
        "OPENROUTER_API_KEY",
        "SPOTLIGHT_RLM_API_KEY"
      ]
    },
    "investigator": {
      "role": "agents/investigator.md",
      "skills": [
        "osint",
        "investigation-methodology",
        "follow-the-money",
        "integrations",
        "content-access",
        "web-archiving",
        "epistemic-grounding",
        "shell-safety",
        "acquisition-graduation",
        "social-media-intelligence",
        "technical-investigation"
      ],
      "tools": [
        "invoke_skill",
        "read_file",
        "write_file",
        "edit_file",
        "list_files",
        "grep_files",
        "hash_files",
        "fetch",
        "search",
        "http_get",
        "browse",
        "query_vault",
        "osint_tools",
        "navigator_tools",
        "exiftool"
      ],
      "keys": [
        "FIRECRAWL_API_KEY"
      ]
    },
    "fact-checker": {
      "role": "agents/fact-checker.md",
      "skills": [
        "osint",
        "content-access",
        "web-archiving",
        "epistemic-grounding",
        "shell-safety",
        "acquisition-graduation",
        "social-media-intelligence",
        "technical-investigation"
      ],
      "tools": [
        "invoke_skill",
        "read_file",
        "write_file",
        "list_files",
        "grep_files",
        "hash_files",
        "fetch",
        "search",
        "http_get",
        "browse",
        "query_vault",
        "osint_tools",
        "navigator_tools",
        "exiftool"
      ],
      "keys": [
        "FIRECRAWL_API_KEY"
      ]
    },
    "researcher": {
      "role": "agents/researcher.md",
      "skills": [
        "osint",
        "content-access",
        "web-archiving",
        "epistemic-grounding"
      ],
      "tools": [
        "invoke_skill"
      ]
    },
    "analyst": {
      "role": "agents/analyst.md",
      "skills": [
        "epistemic-grounding"
      ],
      "tools": [
        "invoke_skill",
        "read_file",
        "list_files",
        "grep_files",
        "query_vault",
        "write_file"
      ],
      "reads": [
        "data/findings.json",
        "data/fact-check.json",
        "data/source-expressions.json",
        "data/source-positions.json",
        "data/evidence-bundle.json",
        "data/decision-signals.json",
        "data/knowledge-proposal.json"
      ],
      "writes": [
        "data/knowledge-proposal.json"
      ],
      "phases": [
        "ingest"
      ],
      "editions": [
        "solo"
      ]
    }
  }
}
