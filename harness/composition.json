        "research/navigator/"
      ]
    },
    "analyst": {
      "role": "agents/analyst.md",
      "skills": [
        "epistemic-grounding",
        "report-drafting"
      ],
      "tools": [
        "invoke_skill",
        "read_file",
        "list_files",
        "grep_files",
        "query_vault",
        "write_file"
      ],
      "reads": [
        "data/findings.json",
        "data/fact-check.json",
        "data/source-expressions.json",
        "data/source-positions.json",
        "data/evidence-bundle.json",
        "data/decision-signals.json",
        "data/knowledge-proposal.json",
        "data/harness-checks/analyst/"
      ],
      "writes": [
        "data/knowledge-proposal.json"
      ],
      "phases": [
        "investigation_gate_approval",
        "report",
        "ingest"
      ],
      "denyWrites": [
        "data/harness-checks/",
        "research/navigator/"
      ],
      "denyReads": [
        "data/harness-checks/investigator/",
        "data/harness-checks/fact-checker/"
      ],
      "phaseScopes": {
        "investigation_gate_approval": {
          "reads": [
            "brief-directions.txt",
            "data/methodology.json",
            "data/findings.json",
            "data/fact-check.json",
            "data/evidence-bundle.json",
            "data/investigation-log.json",
            "data/source-expressions.json",
            "data/summary.json",
            "summary.md",
            "data/harness-checks/analyst/"
          ],
          "writes": [
            "summary.md",
            "data/summary.json"
          ]
        },
        "report": {
          "reads": [
            "brief-directions.txt",
            "data/findings.json",
            "data/fact-check.json",
            "data/summary.json",
            "data/investigation-gate-review.json",
            "data/source-expressions.json",
            "data/report-draft.json",
            "data/decision-signals.json",
            "data/harness-checks/analyst/"
          ],
          "writes": [
            "data/report-draft.json"
          ]
        }
      }
    }
  }
}
